{
  "name": "andaha.web-apps.mini-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "start-pwa": "ng build --configuration local-pwa && http-server -p 4200 -c-1 dist/andaha.web-apps.mini-client"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/material-moment-adapter": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@meddv/ngx-pinch-zoom": "^20.0.0",
    "angular-oauth2-oidc": "^22.0.2",
    "chart.js": "^4.6.1",
    "moment": "^2.31.0",
    "ng2-charts": "^11.0.0",
    "ngx-mat-timepicker": "~21.0.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "ngx-mat-timepicker": {
      "@angular/animations": "$@angular/animations",
      "@angular/cdk": "$@angular/cdk",
      "@angular/common": "$@angular/common",
      "@angular/compiler": "$@angular/compiler",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms",
      "@angular/material": "$@angular/material",
      "@angular/platform-browser": "$@angular/platform-browser"
    }
  }
}
